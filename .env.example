# คัดลอกเป็น .env แล้วแก้ค่าก่อนรัน docker compose

# ---- Database ----
POSTGRES_USER=ipd
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=ipdcharts

# ---- Backend ----
# บังคับ ต้องยาวอย่างน้อย 32 ตัวอักษร ไม่งั้น backend จะไม่ยอม start
# สร้างได้ด้วย: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- แจ้งเตือนทางอีเมล (ช่องทางหลัก) ----
# ไม่ตั้ง SMTP_HOST = ระบบจะไม่ส่งแจ้งเตือนใดๆ ออกไป (จะขึ้นคำเตือนตอน start)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IpdCharts <no-reply@ipdcharts.local>

# ---- แจ้งเตือนทาง LINE (ไม่บังคับ) ----
# ใช้ LINE Messaging API — ต้องมี Official Account และผู้ใช้ต้องแอดเพื่อนก่อน
# หมายเหตุ: LINE Notify แบบเดิมถูกปิดบริการถาวรแล้ว ระบบจึงไม่รองรับ
LINE_CHANNEL_ACCESS_TOKEN=

# ---- ความปลอดภัย (ไม่บังคับ) ----
# ตั้งเมื่อ frontend อยู่คนละ origin กับ API (คั่นหลายค่าด้วย comma)
# ไม่ตั้งบน production = อนุญาตเฉพาะ same-origin ซึ่งเป็นกรณีปกติของ deploy นี้
CORS_ORIGIN=
# จำนวนครั้งที่ล็อกอินได้ต่อ IP ต่อช่วงเวลา (0 = ปิดการจำกัด)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
