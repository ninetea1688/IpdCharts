{
  "name": "@ipdcharts/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=${IPDCHARTS_TEST_DATABASE_URL:-postgresql://ipd:ipd_dev_password@localhost:5432/ipdcharts_test?schema=public} bun test --preload ./src/test/preload.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@prisma/client": "^6.7.0",
    "fastify": "^5.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "prisma": "^6.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  }
}
