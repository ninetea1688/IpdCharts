{
  "name": "@ipdcharts/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=${IPDCHARTS_TEST_DATABASE_URL:-postgresql://ipd:ipd_dev_password@localhost:5433/ipdcharts_test?schema=public} bun test ./src --preload ./src/test/preload.ts",
    "test:e2e": "bun run db:seed && playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:bootstrap": "bun run prisma/bootstrap.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.4.0",
    "jose": "^6.2.8",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "playwright": "^1.62.1",
    "prisma": "^6.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  }
}
