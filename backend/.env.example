# คัดลอกเป็น backend/.env สำหรับรัน dev server (bun run dev)
# พอร์ต 5433 คือพอร์ตที่ docker-compose map ออกมาจาก container postgres

DATABASE_URL="postgresql://ipd:ipd_dev_password@localhost:5433/ipdcharts?schema=public"
PORT=3000

# ต้องยาวอย่างน้อย 32 ตัวอักษร ไม่งั้น server จะไม่ยอม start
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# แจ้งเตือนทางอีเมล — เว้นว่างไว้ได้ตอน dev (ระบบจะข้ามการส่งและขึ้นคำเตือน)
# ทดสอบภายในเครื่องได้ด้วย MailHog: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
# แล้วตั้ง SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IpdCharts <no-reply@ipdcharts.local>"

# LINE Messaging API (ไม่บังคับ)
LINE_CHANNEL_ACCESS_TOKEN=

# ปิดการจำกัดจำนวนครั้งล็อกอินตอน dev ได้ด้วยการตั้งเป็น 0
AUTH_RATE_LIMIT_MAX=10
